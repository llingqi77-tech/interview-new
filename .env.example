# ============================================================
# LGD 群面模拟器 v0.7-tow 环境变量（复制为 .env.local 填入真实值）
# 注意：所有 key 仅存服务端（Vercel 项目环境变量 / 本地 .env.local），
# 前端 bundle 不持有任何 key（C9 / D1）。
# ============================================================

# LLM 文本能力：Kimi / Moonshot（OpenAI 兼容端点，key 仅存服务端，C9）
# 当前默认：kimi-k3（推理模型；temperature 必须为 1；reasoning=low 为实测必需配置）
# 实测全链路（reply 7-10s / topic 11s / feedback 16s / analyze 7s，均达标）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.moonshot.cn/v1
DEEPSEEK_MODEL=kimi-k3
DEEPSEEK_TEMPERATURE=1       # Kimi 只接受 temperature=1
DEEPSEEK_MAX_TOKENS=32768    # 推理模型思考链预算
DEEPSEEK_REASONING=low       # 不设 low 时思考链吃满 max_tokens，正文为空

# 按 action 的模型覆盖（可选）：DEEPSEEK_MODEL_<ACTION> 优先于 DEEPSEEK_MODEL
# 例：reply 交互循环想更快可配 DEEPSEEK_MODEL_REPLY=kimi-k2.7-code-highspeed
# （Moonshot 可用模型：kimi-k3 / kimi-k2.6 / kimi-k2.7-code / kimi-k2.7-code-highspeed）

# 备用端点 A：StepFun step_plan（语音同平台；step-5-preview 推理模型）
# DEEPSEEK_BASE_URL=https://api.stepfun.com/step_plan/v1
# DEEPSEEK_MODEL=step-5-preview
# DEEPSEEK_TEMPERATURE=       # 留空=用调用方默认值
# DEEPSEEK_MAX_TOKENS=32768
# DEEPSEEK_REASONING=low

# 备用端点 B：DeepSeek 官方
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MAX_TOKENS=8192
# DEEPSEEK_REASONING=        # 留空=非推理模型
# StepFun（TTS / ASR 凭证签发；未配置时前端自动降级 Web Speech / 文字）
STEPFUN_API_KEY=

# 阿里云 RDS PostgreSQL 连接串（DATABASE_URL；旧明文凭据必须轮换）
# 格式：postgresql://<user>:<password>@<host>:5432/interview_db?sslmode=require
DATABASE_URL=

# 可选：GitHub Pages 部署时的 base 路径（默认 /）
VITE_BASE_PATH=

# ============================================================
# Para 钱包（Monad Testnet 身份层，Q-N1）—— 公开 key，可上前端
# 获取：npm i -g @getpara/cli && para login && para keys create（见 docs/monad-wallet.md）
# 未配置时钱包 UI 不渲染，应用保持免登录匿名可用
# ============================================================
VITE_PARA_API_KEY=

# ============================================================
# 链上证书（InterviewCertificate soulbound NFT，Monad Testnet chainId 10143）
# 合约部署 + 验证 + 索引器全流程见 docs/monad-onchain.md
# 未配置时铸证 UI 不渲染，报告流程不受影响
# ============================================================
# 部署后的合约地址（0x 前缀 42 字符）
VITE_CERT_ADDRESS=
# Envio HyperIndex 托管 GraphQL 端点（indexer 上 Envio Cloud 后填入；未配置时"我的链上证书"列表隐藏）
VITE_ENVIO_GRAPHQL_URL=

# ============================================================
# 支付宝 AI 网页应用收款（Vibe Pay 基础收款能力）
# 开通步骤见 docs/alipay-aipay.md；未配置时 /api/pay 返回 503，应用其它功能不受影响
# ============================================================
# 开放平台应用 AppID（16 位数字，如 2021000000000000）
ALIPAY_APP_ID=
# 应用私钥：支付宝密钥工具导出的「应用私钥」，单行 base64 或完整 PEM 均可
# 换行可写成字面量 \n；PKCS#1 与 PKCS#8 都支持，用 ALIPAY_KEY_TYPE 指定
ALIPAY_PRIVATE_KEY=
# 支付宝公钥：注意是「支付宝公钥」，不是「应用公钥」
ALIPAY_PUBLIC_KEY=
# 私钥格式：PKCS1（默认，RSA PRIVATE KEY）| PKCS8（PRIVATE KEY）
ALIPAY_KEY_TYPE=PKCS1
# 签名算法：RSA2（默认，推荐）| RSA
ALIPAY_SIGN_TYPE=RSA2
# 网关：生产 https://openapi.alipay.com/gateway.do
#       沙箱 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 异步通知地址（必须是公网可访问的 HTTPS，无空格无重定向）
# 例：https://你的域名/api/pay?action=notify
ALIPAY_NOTIFY_URL=
# 同步回跳地址（用户付完款浏览器跳回的页面，只做展示，不判定成功）
# 例：https://你的域名/api/pay?action=return
ALIPAY_RETURN_URL=
# 可选：校验通知里的收款方（seller_id 或 seller_email 任一命中即通过）
ALIPAY_SELLER_ID=
ALIPAY_SELLER_EMAIL=
# 退款 / 关单接口的管理口令；不配置时这两个接口直接 403（安全默认）
ALIPAY_ADMIN_TOKEN=
# 可选：用 JSON 覆盖商品目录，不用改代码
# ALIPAY_PAY_CATALOG=[{"sku":"practice_10","subject":"群面模拟 10 场","amount":"19.90"}]
