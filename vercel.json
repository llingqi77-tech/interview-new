{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "pnpm install",
  "framework": "vite",
  "git": {
    "deploymentEnabled": true
  },
  "regions": ["hkg1"],
  "alias": ["groupinterview.online"],
  "redirects": [
    { "source": "/app.html", "destination": "/", "permanent": true },
    { "source": "/app", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/avatars/presets",
      "destination": "/api/avatars"
    },
    {
      "source": "/api/asr-token",
      "destination": "/api/asr?__route=token"
    },
    {
      "source": "/api/tts-token",
      "destination": "/api/tts?__route=token"
    },
    {
      "source": "/api/sessions/:id/:action",
      "destination": "/api/sessions?__sessionRoute=:id/:action"
    },
    {
      "source": "/api/sessions/:id",
      "destination": "/api/sessions?__sessionRoute=:id"
    }
  ]
}
