{
  "name": "群面模拟器",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-functions.mjs && vite build",
    "start": "node server/prod-api.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/*.test.ts\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:functions": "node scripts/check-functions.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "pay:doctor": "node scripts/pay-doctor.mjs",
    "verify": "npm run check:secrets && npm run typecheck && npm run test && npm run build && npm run check:bundle",
    "test:e2e": "node scripts/e2e-api.mjs",
    "test:e2e:onchain": "bash scripts/e2e-onchain.sh"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@getpara/evm-wallet-connectors": "^3.23.0",
    "@getpara/react-sdk": "^3.23.0",
    "@mediapipe/tasks-vision": "1.1.1",
    "@tanstack/react-query": "^5.104.3",
    "@types/pg": "^8.18.0",
    "@vercel/node": "^5.6.16",
    "@vercel/postgres": "^0.10.0",
    "pg": "^8.20.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "viem": "^2.57.7",
    "wagmi": "^3.7.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.2",
    "vercel": "^50.33.0",
    "vite": "^6.2.0"
  }
}
