# ============================================================
# 日志与进程
# ============================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.pid.lock
# MSYS / Git Bash 崩溃转储（本机 shell 是 Git Bash，偶发 *.stackdump）
*.stackdump
.node_repl_history

# ============================================================
# 依赖与构建产物
# ============================================================
node_modules
dist
dist-ssr
*.local
# Vite / Turbopack 缓存（node_modules/.vite 已被 node_modules 覆盖，这里兜底自定义 cacheDir）
.vite/
.turbo/
*.tsbuildinfo

# ============================================================
# 编辑器 / IDE
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea
*.iml
# VS Code 本地历史（Local History 扩展）
.history/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================
# 操作系统
# ============================================================
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.Trash-*

# ============================================================
# 环境变量与密钥（D1/C9：任何 key 都不进 git）
# .env.example 是唯一允许提交的模板（值为空）
# ============================================================
.env
.env.*
!.env.example

# 设置页（/api/settings）写入的运行时配置：含明文密钥，绝不入库
.runtime-config.json
.runtime-config.json.*.tmp

# 云平台凭据文件（若从控制台下载到仓库根目录）
secrets.json
credentials.json

# ============================================================
# 证书与私钥
# ============================================================
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.csr
*.jks
*.keystore
id_rsa*
id_ed25519*

# ============================================================
# 测试与覆盖率
# ============================================================
coverage/
.nyc_output/
*.lcov
.eslintcache

# ============================================================
# 工具缓存
# ============================================================
*.npmrc
.pnpm-store/
.npm/
.yarn/
.cache/
.parcel-cache/
.temp/
tmp/
temp/

# ============================================================
# 依赖打包产物
# ============================================================
*.tgz
*.tar.gz
*.zip

# ============================================================
# 备份与临时文件
# ============================================================
*.bak
*.bak-*
*.orig
*.rej
*.tmp
*.temp
*~

# ============================================================
# 本地数据库文件（真实数据在 RDS，本地只允许临时库）
# ============================================================
*.sqlite
*.sqlite3
*.db
*.db-journal

# ============================================================
# 本地草稿（演示/评审中间产物，不提交）
# ============================================================
tododocs/
draft_*/

# ============================================================
# Monad 链上组件（contracts/ + indexer/）
# ============================================================
contracts/out/
contracts/cache/
contracts/broadcast/
# forge 依赖库体积大可重现（git clone --depth 1，见 docs/monad-onchain.md），不入库
contracts/lib/
# Envio HyperIndex 生成物
indexer/node_modules/
indexer/generated/
indexer/.envio/
indexer/.env

# E2E 本地链验证临时产物
.e2e-*

# ============================================================
# 3D 资产产线
# 成品 GLB 在 public/avatars/3d/ 是**故意入库**的（前端直接引用，约 38MB），
# 这里只忽略产线工作区与中间格式（Blender / 转换导出）。
# ============================================================
tripo-out/
*.blend
*.blend1
*.fbx
*.usdz
*.obj
*.mtl
*.stl

# ============================================================
# agent 工具的本地状态（.agents/ 是受管 skill 副本，要入库）
# ============================================================
.pi/
.claude/
.cursor/
.codex/

# autoresearch 会话的 git worktree 容器（autoresearch/<session-id>/）
# 仓库根的 autoresearch.md / .jsonl / .sh / .checks.sh / .ideas.md 是**故意入库**的：
# jsonl 是实验记录的唯一真相源，换台机器靠它续跑；这里只挡 worktree 目录本身。
autoresearch/

# autoresearch 工作文件：只在本机用，不进 GitHub
# （文件保留在磁盘上，只是不跟踪；harness 照常读写）
autoresearch.ideas.md
autoresearch.checks.sh
